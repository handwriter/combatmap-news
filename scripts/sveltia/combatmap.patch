+import { isReactComponent } from '$lib/services/api/react';
+import { preloadImmutable } from '$lib/services/api/immutable';
+import { preloadReactDom } from '$lib/services/api/react-dom';
+
+// Combat Map extension. Registrations are scoped to collection/file, before CMS.init().
+const templates = new Map();
+export const registerHistoryTemplate = (name, component, { hidePreviewLinks = false } = {}) => {
+  if (typeof name !== 'string' || !name.includes('/') || !isReactComponent(component)) {
+    throw new TypeError('registerHistoryTemplate requires collection/file and a React component');
+  }
+  templates.set(name, { component, hidePreviewLinks });
+  preloadImmutable();
+  preloadReactDom();
+};
+export const getHistoryTemplate = (draft) =>
+  templates.get(`${draft?.collectionName}/${draft?.fileName}`);
