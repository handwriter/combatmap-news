+<script>
+  import { createElement } from 'react';
+  import { onMount } from 'svelte';
+  import { loadImmutable, immutableLoaded } from '$lib/services/api/immutable';
+  import { getReactDom, loadReactDom, reactDomLoaded } from '$lib/services/api/react-dom';
+  import { buildPreviewData, convertEntryToMap } from '$lib/services/api/preview-data';
+  import { getEntryDraftContext } from '$lib/services/contents/draft/state.svelte';
+  import { getValueMapSnapshot } from '$lib/services/contents/draft/value-map.svelte';
+  import { setSubtree } from '$lib/services/contents/entry/subtree';
+  import { isDraftReadonly } from '$lib/services/config/readonly';
+  import { unflattenMap } from '$lib/services/utils/object';
+
+  let { component } = $props();
+  const entryDraft = getEntryDraftContext();
+  let container = $state();
+  let ready = $state(false);
+  let error = $state('');
+  let root;
+
+  onMount(() => {
+    let alive = true;
+    Promise.all([loadImmutable(), loadReactDom()]).then(() => {
+      if (alive) ready = true;
+    }).catch((ex) => { if (alive) error = ex.message; });
+    return () => { alive = false; root?.unmount(); };
+  });
+
+  $effect(() => {
+    const draft = entryDraft.current;
+    if (!draft || !ready || !container || !immutableLoaded.current || !reactDomLoaded.current) return;
+    const locale = (draft.collectionFile ?? draft.collection)._i18n.defaultLocale;
+    const currentValues = getValueMapSnapshot(draft, locale);
+    const { entryMap } = buildPreviewData({ draft: { ...draft, currentValues: { ...draft.currentValues, [locale]: currentValues } }, locale });
+    const assertCurrent = () => {
+      if (entryDraft.current !== draft || isDraftReadonly(draft)) throw new Error('Этот черновик больше недоступен для изменения');
+    };
+    const props = {
+      entry: entryMap,
+      originalEntry: convertEntryToMap({ entry: draft.originalEntry, locale, collectionName: draft.collectionName, associatedAssets: [] }),
+      readonly: isDraftReadonly(draft),
+      getDraftData: () => { assertCurrent(); return structuredClone(unflattenMap(getValueMapSnapshot(draft, locale))); },
+      replaceDraft: (data) => {
+        assertCurrent();
+        if (!data || typeof data !== 'object' || Array.isArray(data)) throw new TypeError('Данные черновика должны быть объектом');
+        // Prepare a detached replacement before touching the live, versioned value map.
+        const replacement = structuredClone(data);
+        const target = draft.currentValues[locale];
+        for (const key of Object.keys(target)) delete target[key];
+        for (const [key, value] of Object.entries(replacement)) {
+          if (value && typeof value === 'object') setSubtree(target, key, value);
+          else target[key] = value;
+        }
+        // originalValues stays intact: unsaved diff, cancel and validation retain their meaning.
+      },
+    };
+    root ??= getReactDom().createRoot(container);
+    root.render(createElement(component, props));
+  });
+</script>
+
+{#if error}<p role="alert">{error}</p>{/if}
+<div bind:this={container}></div>
