{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combat Map JSON v1",
  "type": "object",
  "required": [
    "id",
    "maxPlayers",
    "cameraBounds",
    "terrain",
    "players"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "maxPlayers": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "maxUnitsPerPlayer": {
      "type": "integer",
      "minimum": 0
    },
    "cameraBounds": {
      "$ref": "#/$defs/bounds"
    },
    "mapBounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/bounds"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "sx": {
              "type": "number"
            },
            "sy": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "terrain": {
      "$ref": "#/$defs/terrain"
    },
    "players": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/player"
      }
    },
    "bridges": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/bridge"
      }
    },
    "zones": {
      "anyOf": [
        {
          "$ref": "#/$defs/zoneMask"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "required": [
        "cx",
        "cy",
        "sx",
        "sy"
      ],
      "properties": {
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "sx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sy": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "terrain": {
      "type": "object",
      "required": [
        "gridWidth",
        "gridHeight"
      ],
      "properties": {
        "gridWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "gridHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "cells": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "maxItems": 4194304
        },
        "trees": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/tree"
          }
        },
        "format": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "rle": {
          "type": [
            "string",
            "null"
          ]
        },
        "blendX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "blendY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "urban": {
          "anyOf": [
            {
              "$ref": "#/$defs/urban"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "required": [
        "x",
        "y",
        "variant",
        "scale",
        "flipX"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "variant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flipX": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "player": {
      "type": "object",
      "required": [],
      "properties": {
        "spawnPoints": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/spawn"
          }
        },
        "cities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/city"
          }
        },
        "startingZones": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/zone"
          }
        }
      },
      "additionalProperties": false
    },
    "spawn": {
      "type": "object",
      "required": [
        "x",
        "y",
        "unitTypeId"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "unitTypeId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "city": {
      "type": "object",
      "required": [
        "x",
        "y",
        "cityId"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "cityId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "isCapital": {
          "type": "boolean"
        },
        "startsNeutral": {
          "type": "boolean"
        },
        "productionSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "required": [
        "px",
        "py",
        "cx",
        "cy",
        "sx",
        "sy"
      ],
      "properties": {
        "px": {
          "type": "number"
        },
        "py": {
          "type": "number"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "sx": {
          "type": "number"
        },
        "sy": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "bridge": {
      "type": "object",
      "required": [
        "x",
        "y",
        "rotation"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "urban": {
      "type": "object",
      "required": [
        "scale",
        "seed",
        "rle",
        "houses",
        "streets",
        "squares"
      ],
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 3
        },
        "seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "rle": {
          "type": "string"
        },
        "houses": {
          "type": "string"
        },
        "streets": {
          "type": "string"
        },
        "squares": {
          "type": "string"
        }
      }
    },
    "zoneMask": {
      "type": "object",
      "required": [
        "originX",
        "originY",
        "cellSize",
        "width",
        "height",
        "rle"
      ],
      "additionalProperties": false,
      "properties": {
        "originX": {
          "type": "number"
        },
        "originY": {
          "type": "number"
        },
        "cellSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "rle": {
          "type": "string"
        }
      }
    }
  }
}
